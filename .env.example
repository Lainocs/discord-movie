# Token du bot Discord (Discord Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=

# Client ID de ton application Discord (Developer Portal > General Information > Application ID)
CLIENT_ID=

# ID du serveur Discord ou tu veux utiliser le bot (clic droit sur le serveur > Copier l'ID
# avec le mode developpeur active dans Discord > Parametres > Avance)
GUILD_ID=

# Ton pseudo Letterboxd (celui qui apparait dans l'URL, ex: letterboxd.com/nicolas/ -> nicolas)
LETTERBOXD_USERNAME=

# Cle API TMDb (gratuite, a creer sur https://www.themoviedb.org/settings/api)
TMDB_API_KEY=
